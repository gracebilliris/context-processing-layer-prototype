# CPL prototype environment configuration
# Copy this file to .env and fill in the values.

# --- Required ---
# Google Gemini API key used by the n8n LangChain agent for extraction.
# Obtain one from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Kafka ---
KAFKA_TOPIC=context-processing-layer-trigger-topic
KAFKA_HOST_PORT=9092

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=cpl
MONGO_INITDB_ROOT_PASSWORD=cpl
MONGO_HOST_PORT=27017
MONGO_DB_NAME=cpl

# --- n8n ---
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
# Persisted volume for n8n workflows and credentials
N8N_DATA_DIR=./.n8n-data
